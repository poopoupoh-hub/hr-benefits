# ===== ฐานข้อมูล =====
# SQLite (ค่าเริ่มต้น — ไม่ต้องติดตั้งอะไรเพิ่ม ไฟล์อยู่ที่ prisma/dev.db)
DATABASE_URL="file:./prisma/dev.db"
# PostgreSQL (ดูวิธีเปลี่ยนใน docs/GETTING-STARTED.md)
# DATABASE_URL="postgresql://postgres:password@localhost:5432/hr_benefits"

# ===== ความปลอดภัย =====
# กุญแจลงลายมือชื่อ session cookie — ต้องเป็นค่าสุ่มยาว ๆ (npm run setup จะสร้างให้อัตโนมัติ)
SESSION_SECRET="change-me-to-a-long-random-string"

# ===== อื่น ๆ =====
# โฟลเดอร์เก็บไฟล์แนบ (แยกจากฐานข้อมูลหลัก)
UPLOAD_DIR="./storage/uploads"
# timezone ที่ใช้คำนวณวันตัดรอบ/วันจ่าย
APP_TIMEZONE="Asia/Bangkok"
# ส่งรายชื่อบัญชีทดสอบออกทาง /api/state (หน้าเข้าสู่ระบบไม่แสดงรายชื่อ/บทบาทอยู่แล้ว) — ปิดไว้เป็นค่าเริ่มต้น
SHOW_DEMO_ACCOUNTS="false"
