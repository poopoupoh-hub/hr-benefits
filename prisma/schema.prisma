// ============================================================
// ระบบจัดการข้อมูลพนักงานและสวัสดิการ — Database schema (Prisma 7)
// ค่าเริ่มต้นใช้ SQLite (ไฟล์ prisma/dev.db) — เปลี่ยนเป็น PostgreSQL ได้ ดู docs/GETTING-STARTED.md
//
// หมายเหตุการออกแบบ
// - วันที่แบบปฏิทิน (YYYY-MM-DD) เก็บเป็น String เพื่อไม่ให้เพี้ยนตาม timezone
// - ฟิลด์ที่เป็นรายการ/โครงสร้าง (เช่น eligibleTypes) เก็บเป็น JSON string ให้ใช้ได้ทั้ง SQLite และ PostgreSQL
// - ไฟล์แนบเก็บบนดิสก์ (storage/uploads) — ตาราง StoredFile/ClaimAttachment เก็บเฉพาะ metadata
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Department {
  id        String     @id
  code      String     @unique
  name      String
  employees Employee[]
}

/// ตำแหน่ง/ระดับ — แยกจากฝ่าย; level 1 เจ้าหน้าที่, 2 ผู้ช่วยผู้จัดการ, 3 ผู้จัดการ, 4 ผู้บริหาร
model Position {
  id        String     @id
  name      String
  level     Int        @default(1)
  employees Employee[]
}

model Employee {
  id              String     @id
  code            String     @unique
  firstName       String
  lastName        String
  email           String     @unique
  phone           String?
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id])
  positionId      String
  position        Position   @relation(fields: [positionId], references: [id])
  supervisorId    String?
  supervisor      Employee?  @relation("Supervision", fields: [supervisorId], references: [id])
  subordinates    Employee[] @relation("Supervision")
  /// permanent | probation | contract | terminated
  employmentType  String
  startDate       String
  contractEndDate String?
  /// employee | hr | hr_head | finance | admin
  role            String     @default("employee")
  active          Boolean    @default(true)
  /// scrypt hash
  passwordHash    String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime
  claims          Claim[]
}

model BenefitType {
  id              String          @id
  code            String          @unique
  name            String
  /// หมวด ใช้จัดกลุ่มใน Dropdown
  category        String          @default("อื่น ๆ")
  description     String?
  /// claim (พนักงานแจ้งยอด) | assigned (HR กำหนดยอด)
  mode            String          @default("claim")
  /// JSON: EmploymentType[]
  eligibleTypes   String
  /// JSON: string[]
  requiredDocs    String
  minServiceDays  Int?
  claimWindowDays Int?
  sensitive       Boolean         @default(false)
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  limits          BenefitLimit[]
  fundRounds      FundRound[]
  claims          Claim[]
}

/// วงเงินตามระดับตำแหน่ง — เพิ่มแถวใหม่เมื่อเปลี่ยน (ไม่แก้ทับ) ใช้ฉบับล่าสุดที่มีผลแล้ว
model BenefitLimit {
  id            String      @id
  benefitId     String
  benefit       BenefitType @relation(fields: [benefitId], references: [id])
  minLevel      Int
  maxLevel      Int
  perClaim      Decimal?
  perYear       Decimal?
  maxCount      Int?
  effectiveFrom String
  createdAt     DateTime    @default(now())

  @@index([benefitId, effectiveFrom])
}

model FundRound {
  id            String      @id
  benefitTypeId String
  benefitType   BenefitType @relation(fields: [benefitTypeId], references: [id])
  name          String
  budget        Decimal
  openFrom      String
  openTo        String
  maxPerPerson  Decimal?
  /// open | closed
  status        String      @default("open")
  createdAt     DateTime    @default(now())
  claims        Claim[]
}

model Claim {
  id             String            @id
  no             String            @unique
  employeeId     String
  employee       Employee          @relation(fields: [employeeId], references: [id])
  benefitTypeId  String
  benefitType    BenefitType       @relation(fields: [benefitTypeId], references: [id])
  fundRoundId    String?
  fundRound      FundRound?        @relation(fields: [fundRoundId], references: [id])
  /// เลขที่ใบเสร็จ
  receiptNo       String            @default("")
  /// ร้าน / บริษัท / โรงพยาบาล
  vendorName      String            @default("")
  /// ยอดตามใบเสร็จ
  amountRequested Decimal           @default(0)
  /// ยอดเบิกได้จริง
  amountApproved  Decimal           @default(0)
  receiptDate     String
  note            String?
  /// pending_hr | returned | rejected | approved | paid
  status          String
  submittedAt     DateTime
  decidedById     String?
  decidedAt       DateTime?
  payDate         String?
  rejectReason    String?
  returnReason    String?
  attachments     ClaimAttachment[]
  events          ClaimEvent[]
  payment         Payment?

  @@index([receiptNo, vendorName])

  @@index([employeeId, benefitTypeId, status])
  @@index([status, payDate])
}

model ClaimAttachment {
  id         String   @id
  claimId    String
  claim      Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  position   Int
  name       String
  size       Int
  type       String
  docType    String
  uploadedAt DateTime

  @@index([claimId])
}

model ClaimEvent {
  id         Int      @id @default(autoincrement())
  claimId    String
  claim      Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  seq        Int
  at         DateTime
  actorId    String
  action     String
  fromStatus String?
  toStatus   String?
  note       String?

  @@index([claimId, seq])
}

/// บันทึกการจ่ายเงินรายคำขอ
model Payment {
  claimId     String   @id
  claim       Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  /// cash | transfer | cheque
  method      String
  paidAt      String
  transferRef String?
  chequeNo    String?
  chequeDate  String?
  recordedBy  String
  recordedAt  DateTime
  note        String?
}

/// คำขอแก้ไข (Maker–Checker) — HR ขอ หัวหน้า HR อนุมัติ
model ChangeRequest {
  id           String    @id
  /// claim_status | benefit_limit
  kind         String
  targetId     String
  /// JSON
  before       String
  /// JSON
  after        String
  reason       String
  requestedBy  String
  requestedAt  DateTime
  /// pending | approved | rejected
  status       String
  reviewedBy   String?
  reviewedAt   DateTime?
  reviewNote   String?
  selfApproved Boolean   @default(false)

  @@index([status])
  @@index([targetId])
}

/// ไฟล์จริงที่อัปโหลด (เก็บบนดิสก์ แยกจากฐานข้อมูลหลัก)
model StoredFile {
  id          String   @id
  uploaderId  String
  name        String
  mimeType    String
  size        Int
  storagePath String
  createdAt   DateTime @default(now())
}

model Holiday {
  date String @id
  name String
}

model Setting {
  key   String @id
  /// JSON
  value String
}

model RolePermission {
  role       String
  permission String

  @@id([role, permission])
}

/// Audit Log — append-only (ระบบไม่มีฟังก์ชันแก้ไข/ลบ)
model AuditLog {
  id        String   @id
  at        DateTime
  actorId   String?
  actorRole String?
  action    String
  entity    String
  entityId  String?
  summary   String
  /// JSON
  before    String?
  /// JSON
  after     String?

  @@index([entity, entityId])
  @@index([at])
}

model EmailMessage {
  id      String   @id
  at      DateTime
  /// JSON: string[]
  to      String
  subject String
  body    String
  event   String
  /// sent | skipped
  status  String

  @@index([at])
}

model Counter {
  key   String @id
  value Int
}
